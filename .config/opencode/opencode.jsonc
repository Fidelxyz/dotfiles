{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "bash": {
            "*": "ask",
            "rm *": "deny",
            "npm *": "deny",
            "pip3 *": "deny",
            "echo *": "allow",
            "ls *": "allow",
            "cat *": "allow",
            "find *": "allow",
            "grep *": "allow",
            "head *": "allow",
            "tail *": "allow",
            "wc *": "allow",
            "fd *": "allow",
            "rg *": "allow",
            "xxd *": "allow",
            "which *": "allow",
            "git status *": "allow",
            "git show *": "allow",
            "git diff *": "allow",
            "git log *": "allow",
            "git remote -v": "allow",
            "git branch -a": "allow",
            "jj st *": "allow",
            "jj status *": "allow",
            "jj show *": "allow",
            "jj diff *": "allow",
            "jj log *": "allow",
            "jj file list *": "allow",
            "jj file search *": "allow",
            "jj file show *": "allow",
            "jj file log *": "allow"
        },
        "external_directory": {
            "/tmp/**": "allow",
        }
    },
    "mcp": {
        "github": {
            "type": "remote",
            "url": "https://api.githubcopilot.com/mcp/",
            "oauth": false,
            "headers": {
                "Authorization": "Bearer {env:GITHUB_MCP_PAT}"
            }
        },
        "markitdown": {
            "type": "local",
            "command": [
                "uvx",
                "markitdown-mcp"
            ]
        }
    },
}
